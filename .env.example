# ==============================================================================
# DDCET RankRise - Environment Variables Template
# Copy this file to .env for local development:
# cp .env.example .env
# ==============================================================================

# --- Backend Configuration ---
# Secret key used for signing JWT tokens (Required)
JWT_SECRET=super_secret_rankrise_dev_key_2026

# Backend server port (Default: 3001)
PORT=3001

# Allowed Frontend URL for CORS (Optional in dev, e.g. https://your-frontend.onrender.com in prod)
FRONTEND_URL=http://localhost:5173

# Node Environment ('development' or 'production')
NODE_ENV=development

# PostgreSQL Connection String (Optional for local dev - if omitted, JSON db is used)
# Example: postgresql://postgres:password@localhost:5432/ddcet_rankrise
# DATABASE_URL=

# --- Frontend Configuration (Vite) ---
# URL of your Express backend API (Default: http://localhost:3001)
VITE_API_URL=http://localhost:3001
